{{- if eq .chezmoi.os "windows" -}}
# Installs a stub at $PROFILE that dot-sources the chezmoi-managed profile.
# The stub only points at the managed profile, so this re-runs only when this
# script changes, not on every profile edit.

$ErrorActionPreference = 'Stop'

$source = Join-Path $HOME '.config\powershell\profile.ps1'
$target = $PROFILE.CurrentUserCurrentHost
$targetDir = Split-Path -Parent $target

if (-not (Test-Path $targetDir)) {
    New-Item -ItemType Directory -Path $targetDir -Force | Out-Null
}

$stub = "# Auto-generated by chezmoi. Do not edit.`r`n. `"$source`"`r`n"

if (-not (Test-Path $target) -or ((Get-Content -Raw -Path $target) -ne $stub)) {
    if (Test-Path $target) {
        $existing = Get-Content -Raw -Path $target
        # Back up any non-stub profile (i.e. user content we'd otherwise clobber)
        if ($existing -notmatch 'Auto-generated by chezmoi') {
            $backup = "$target.bak"
            Copy-Item -Path $target -Destination $backup -Force
            Write-Host "Backed up existing profile: $backup"
        }
    }
    Set-Content -Path $target -Value $stub -Encoding UTF8 -NoNewline
    Write-Host "Installed PowerShell profile stub: $target -> $source"
} else {
    Write-Host "PowerShell profile stub already up-to-date: $target"
}
{{- end }}
